# Environment Variables for WhatsApp Notifications

# Twilio Account Credentials
# Get these from your Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio WhatsApp Number
# This is your Twilio WhatsApp-enabled phone number
# Format: whatsapp:+14155238886 (Twilio Sandbox number)
# Or your own WhatsApp Business number after approval
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Admin Phone Number (receives order notifications)
# Format: whatsapp:+92XXXXXXXXXX (replace with actual number)
ADMIN_PHONE_NUMBER=whatsapp:+92XXXXXXXXXX

# Partner Phone Number (receives order notifications)
# Format: whatsapp:+92XXXXXXXXXX (replace with actual number)
PARTNER_PHONE_NUMBER=whatsapp:+92XXXXXXXXXX

# Server Port
PORT=3000
